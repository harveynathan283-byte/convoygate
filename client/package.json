{
  "name": "convoygate-client",
  "version": "1.0.0",
  "description": "ConvoyGate Mod Launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "axios": "^1.6.8"
  },
  "devDependencies": {
    "electron": "^29.4.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.convoygate.client",
    "productName": "ConvoyGate-Launcher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    }
  }
}