{
  "name": "convoygate-client",
  "version": "1.0.0",
  "description": "ConvoyGate Mod Manager Client",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.convoygate.client",
    "productName": "ConvoyGate",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "harveynathan283-byte",
        "repo": "convoygate"
      }
    ],
    "extraFiles": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "convoygate.dll",
          "convoygate_plugin.dll"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "ConvoyGate-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ConvoyGate",
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "axios": "^1.6.8",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  }
}