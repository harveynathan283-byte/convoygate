{
  "name": "convoygate-client",
  "version": "1.0.0",
  "description": "ConvoyGate ATS & ETS2 Mod Sync & Decryption Engine",
  "main": "src/main.js",
  "author": "ConvoyGate",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "axios": "^1.6.8"
  },
  "devDependencies": {
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.convoygate.client",
    "productName": "ConvoyGate",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ConvoyGate",
      "runAfterFinish": true
    }
  }
}