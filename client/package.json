{
  "name": "convoygate-client",
  "version": "1.0.0",
  "description": "ConvoyGate Mod Manager Client",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.convoygate.client",
    "productName": "ConvoyGate",
    "directories": {
      "output": "dist"
    },
    "extraFiles": [
      {
        "from": "../plugin",
        "to": ".",
        "filter": [
          "**/convoygate_plugin.dll",
          "convoygate_plugin.dll"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ConvoyGate",
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "axios": "^1.6.8"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  }
}